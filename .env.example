# 复制为 .env 并按需修改。所有变量均有代码内默认值，可留空。

# 本地推理 Python 解释器（默认 E:\conda\envs\sdenv\python.exe）
DSH_VISIT_PYTHON=E:\conda\envs\sdenv\python.exe

# 模型权重目录（默认 <项目根>/models）
DSH_VISIT_MODELS_DIR=

# 数据集目录（默认 <项目根>/data）
DSH_VISIT_DATA_DIR=

# 项目根目录（默认由代码自动推断，一般无需设置）
DSH_VISIT_ROOT=

# 云端 describe_image 的凭据（Qwen-VL，由 DSH 凭据存储提供，非本文件）
# QWEN_VISION_API_KEY=sk-xxx
